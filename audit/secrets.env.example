# AgencyOS audit - paste your real values here, then run:  powershell -File C:\Users\weezy\agencyos-audit\_infra\apply-secrets.ps1
# NVIDIA NIM key from https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=
# MongoDB Atlas connection string, e.g. mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
# Leave blank to keep using the local MongoDB at mongodb://127.0.0.1:27017
MONGODB_URI=
# NIM model. NOTE: openai/gpt-oss-120b reached end-of-life on NIM (HTTP 410). Live options: openai/gpt-oss-20b, nvidia/nemotron-3-super-120b-a12b
NIM_MODEL=openai/gpt-oss-20b
